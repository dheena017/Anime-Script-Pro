# ==========================================
# ANIME SCRIPT PRO - ENVIRONMENT CONFIG (EXAMPLE)
# ==========================================

# ------------------------------------------
# 1. Core AI Providers
# ------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# OpenAI API Key for GPT models
OPENAI_API_KEY=

# Anthropic API Key for Claude models
ANTHROPIC_API_KEY=

# Groq API Key for Llama and Mixtral models (Free Tier available)
GROQ_API_KEY=

# NVIDIA API Key for high-performance Llama-3.1 and Nemotron models
NVIDIA_API_KEY=

# Other AI Providers
JULES_API_KEY=
HF_API_TOKEN=

# ------------------------------------------
# 2. Video Generation
# ------------------------------------------
VIDEO_PROVIDER=production_anime
RUNWAY_API_KEY=

# ------------------------------------------
# 3. Audio Generation
# ------------------------------------------
ELEVENLABS_API_KEY=

# ------------------------------------------
# 4. Database Configuration
# ------------------------------------------
DATABASE_URL=sqlite:///./backend/database/anime_script_pro.db

# ------------------------------------------
# 5. Supabase Configuration
# ------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------
# 6. Application / Server Settings
# ------------------------------------------
ENV=development
VITE_ENV=development
VITE_APP_NAME="Anime Script Pro"
VITE_STUDIO_VERSION="1.5.0-GODMODE"

# URLs
APP_URL="MY_APP_URL"
BACKEND_URL=http://127.0.0.1:3050
VITE_API_BASE_URL=

# Ports
PORT=3000
BACKEND_PORT=3050
LIGHTHOUSE_PORT=1515

# Security / Bypass
BYPASS_AUTH=false
